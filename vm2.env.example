# Plantilla del .env que va en VM2, junto a docker-compose.vm2.yml.
# En la VM: copiar a ".env" en esa misma carpeta (NO commitear el .env
# real -- distinto nombre a proposito para que ESTE archivo, sin secretos
# reales, sí pueda commitearse como referencia; ver .gitignore).

# Secreto de firma de JWT -- generado con "openssl rand -base64 64".
# TIENE que ser el mismo valor para auth-service, compra-service y
# licitacion-service (los 3 corren en esta misma VM/compose, así que un
# solo valor alcanza para los 3).
AUTH_JWT_SECRET=

# Postgres corre en esta misma VM (ver el servicio "postgres" en
# docker-compose.vm2.yml) -- ya no hace falta DB_HOST, los 3 servicios
# Java le hablan por el nombre de servicio de Compose. Elegí acá el
# usuario/contraseña del Postgres (no vienen de Azure, es un usuario
# normal de Postgres, lo define este mismo .env).
DB_USERNAME=
DB_PASSWORD=

# Clave AES-256 para cifrar las credenciales de Chile Compra de cada
# empresa (ver CifradoAesService en auth-service) -- generada con:
#   openssl rand -base64 32
# OJO: si se pierde o cambia, las credenciales ya guardadas quedan
# indescifrables para siempre.
CHILECOMPRA_ENCRYPTION_KEY=

# Auth key de Tailscale -- generar en
# https://login.tailscale.com/admin/settings/keys ("Generate auth key",
# con "Reusable" activado).
TS_AUTHKEY=

# IP de Tailscale de la máquina que actúa de exit node residencial (ver
# "tailscale status" en esa máquina -- la que dice "offers exit node").
TS_EXIT_NODE_IP=

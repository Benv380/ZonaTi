# Plantilla del .env que va en VM1, junto a docker-compose.vm1.yml.
# En la VM: copiar a ".env" en esa misma carpeta (NO commitear el .env
# real -- distinto nombre a proposito para que ESTE archivo, sin secretos
# reales, sí pueda commitearse como referencia; ver .gitignore, ".env"/
# ".env.*" quedan afuera del repo pero "vm1.env.example" no matchea eso).

# IP PRIVADA de VM2 dentro de la VNet de Azure (ej. 10.0.0.5) -- se ve en
# el portal, en la pagina de VM2 -> "Redes" -> "Interfaz de red" -> IP
# privada. Tiene que ser IP fija (estatica), no dinamica -- si Azure se la
# cambia sola en algun reinicio, el gateway deja de encontrar el backend.
VM2_PRIVATE_IP=10.0.0.5

# Plantilla del .env que va en VM3, junto a docker-compose.vm3.yml.
# En la VM: copiar a ".env" en esa misma carpeta (NO commitear el .env
# real -- ver .gitignore).

# Usuario y contraseña del administrador de Postgres -- elegilos vos (no
# vienen de ningún lado de Azure, es solo un usuario de Postgres normal).
# TIENEN que coincidir con DB_USERNAME/DB_PASSWORD del .env de VM2.
DB_USERNAME=
DB_PASSWORD=
